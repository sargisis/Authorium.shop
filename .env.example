# Database (SQLite is stored in the Docker volume by default)
DATABASE_URL=/data/authorium.db?_journal_mode=WAL&_busy_timeout=5000&_foreign_keys=on

# Telegram Bot & Mini App
TELEGRAM_BOT_TOKEN=
WEBAPP_URL=https://app.authorium.store

# Backend API Configuration
PORT=8080

# Internal & External API URLs
API_INTERNAL_URL=http://backend:8080/api/v1
NEXT_PUBLIC_API_URL=https://api.authorium.store/api/v1
VITE_API_URL=https://api.authorium.store/api/v1
CORS_ALLOWED_ORIGINS=

# Host binding and published ports
HOST_BIND_IP=127.0.0.1
BACKEND_PORT=8080
FRONTEND_PORT=3000
ADMIN_PORT=8082
LANDING_PORT=3001

# Cloudflare Tunnel Token
CLOUDFLARE_TUNNEL_TOKEN=

